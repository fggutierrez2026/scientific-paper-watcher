# Scientific Paper Watcher configuration

PAPER_WATCHER_DB=data/papers.db
PAPER_WATCHER_REPORT_DIR=reports

REQUEST_TIMEOUT=15
MAX_RETRIES=3

# NCBI E-utilities
NCBI_EMAIL=your_email@example.com
NCBI_API_KEY=

# bioRxiv and medRxiv (both are queried on every run)
BIORXIV_INTERVAL=30d

# Optional OpenAlex enrichment (citations, topics, and open-access PDF)
OPENALEX_ENABLED=false
OPENALEX_API_KEY=

# Enabled sources (comma-separated)
# New adapters remain opt-in until their implementation task is complete.
# Search scope is selected with --scope or stored per watch query (default: papers).
PAPER_SOURCES=pubmed,arxiv,biorxiv,medrxiv
PATENT_SOURCES=

# Additional scholarly APIs
# Semantic Scholar discovery is implemented and remains opt-in via PAPER_SOURCES.
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=your_email@example.com
CORE_API_KEY=
UNPAYWALL_EMAIL=your_email@example.com
LENS_API_TOKEN=

# Patent APIs
USPTO_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
WIPO_USERNAME=
WIPO_PASSWORD=
